# Two existing native Rust binaries, two independent final images. Neither
# image contains the legacy provider-linked temporal_worker executable.
# This is an opt-in runtime topology experiment, not a production cutover.
FROM rust:1.100.0-slim-bookworm AS build-base

RUN apt-get update && apt-get install -y --no-install-recommends \
    protobuf-compiler libprotobuf-dev libssl-dev pkg-config \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app
ENV SQLX_OFFLINE=true \
    CARGO_PROFILE_RELEASE_OPT_LEVEL=0 \
    CARGO_PROFILE_RELEASE_CODEGEN_UNITS=256 \
    CARGO_PROFILE_RELEASE_STRIP=symbols

# The build context is produced by the canonical Cargo metadata-based
# prepare_worker_build_context.py for ONE owner and ONE exact committed SHA.
# Unrelated workspace sources are absent; unchanged manifests and generated
# dependency skeleton keep third-party compilation in a reusable Docker layer.
ARG OWNER_PACKAGE
COPY dependency-skeleton/app ./app
RUN case "$OWNER_PACKAGE" in \
      temporal_orchestrator) set -- --features legacy-workflows ;; \
      temporal_pg_effects) set -- ;; \
      *) echo "invalid owner package" >&2; exit 1 ;; \
    esac \
    && cargo build --release --locked --manifest-path /app/app/rust/Cargo.toml \
      -p "$OWNER_PACKAGE" --bin "$OWNER_PACKAGE" "$@"

COPY app ./app
# Docker COPY can preserve an old source mtime; guarantee fresh owner codegen
# without invalidating the independent dependency skeleton compilation layer.
RUN find /app/app/rust -type f -name '*.rs' \
    \( -path '*/src/*' -o -name 'build.rs' \) -exec touch {} + \
    && case "$OWNER_PACKAGE" in \
      temporal_orchestrator) set -- --features legacy-workflows ;; \
      temporal_pg_effects) set -- ;; \
      *) echo "invalid owner package" >&2; exit 1 ;; \
    esac \
    && cargo build --release --locked --manifest-path /app/app/rust/Cargo.toml \
      -p "$OWNER_PACKAGE" --bin "$OWNER_PACKAGE" "$@"

FROM build-base AS pure-builder

FROM build-base AS pg-builder

FROM debian:bookworm-slim AS runtime
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
USER 65532:65532

FROM runtime AS pure
COPY --from=pure-builder /app/app/rust/target/release/temporal_orchestrator /usr/local/bin/temporal_orchestrator
ENTRYPOINT ["/usr/local/bin/temporal_orchestrator"]

FROM runtime AS pg
COPY --from=pg-builder /app/app/rust/target/release/temporal_pg_effects /usr/local/bin/temporal_pg_effects
ENTRYPOINT ["/usr/local/bin/temporal_pg_effects"]
